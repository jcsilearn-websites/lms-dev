{
  "name": "lms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lms/backend --filter @lms/frontend run \"/^dev(:worker)?$/\"",
    "dev:no-worker": "pnpm --parallel --filter @lms/backend --filter @lms/frontend run dev",
    "dev:worker": "pnpm --filter @lms/backend run dev:worker",
    "build": "pnpm --filter @lms/backend run build && pnpm --filter @lms/frontend run build",
    "lint": "biome check . && pnpm run lint:deps",
    "lint:deps": "depcruise backend/src backend/test backend/bench frontend/src --config .dependency-cruiser.cjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter @lms/backend run typecheck && pnpm --filter @lms/frontend run typecheck",
    "test": "pnpm --filter @lms/backend run test && pnpm --filter @lms/frontend run test",
    "db:local:setup": "pnpm --filter @lms/backend run db:local:setup",
    "db:migrate": "pnpm --filter @lms/backend run db:migrate",
    "db:seed": "pnpm --filter @lms/backend run db:seed",
    "demo:seed": "pnpm --filter @lms/backend run demo:seed",
    "demo:reset": "pnpm --filter @lms/backend run demo:reset",
    "demo:video": "pnpm --filter @lms/backend run demo:video",
    "bench": "pnpm --filter @lms/backend run bench",
    "docs:permissions": "pnpm --filter @lms/backend run docs:permissions",
    "admin:create": "pnpm --filter @lms/backend run admin:create --",
    "mfa:rekey": "pnpm --filter @lms/backend run mfa:rekey --",
    "mfa:reset": "pnpm --filter @lms/backend run mfa:reset --",
    "loadtest:test": "pnpm --filter @lms/loadtest run test",
    "loadtest:seed": "pnpm --filter @lms/loadtest run seed --",
    "loadtest:run": "pnpm --filter @lms/loadtest run run --",
    "loadtest:local": "node loadtest/scripts/local-run.mjs",
    "loadtest:smoke": "pnpm --filter @lms/loadtest run smoke",
    "db:backup": "node scripts/backup/backup.mjs",
    "db:restore": "node scripts/backup/restore.mjs",
    "db:verify-restore": "node scripts/backup/verify-restore.mjs",
    "db:verify-roles": "node scripts/backup/verify-roles.mjs",
    "db:restore-drill": "pnpm --filter @lms/backend exec vitest run --project serial test/backup.restore-drill.test.ts",
    "privacy:reapply-erasures": "pnpm --filter @lms/backend run privacy:reapply-erasures --",
    "start": "pnpm --filter @lms/backend run start",
    "db:dev:clean": "pnpm --filter @lms/backend run db:dev:clean --",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "audit:deps": "node scripts/audit.mjs",
    "secrets:scan": "gitleaks git --redact --no-banner --config .gitleaks.toml",
    "e2e": "pnpm --filter @lms/frontend run e2e",
    "bundle:check": "pnpm --filter @lms/frontend run bundle:check",
    "lighthouse": "pnpm --filter @lms/frontend run lighthouse",
    "screenshots": "pnpm --filter @lms/frontend run screenshots"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "dependency-cruiser": "^18.7.0",
    "typescript": "~6.0.3"
  }
}
