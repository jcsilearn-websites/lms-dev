#!/bin/sh
# Secret scan of the staged changes (gitleaks, rules in .gitleaks.toml). Enabled by `pnpm install`
# (the `prepare` script sets core.hooksPath). Install gitleaks: https://github.com/gitleaks/gitleaks#installing
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the secret scan cannot run." >&2
  echo "  Windows: winget install gitleaks.gitleaks   macOS: brew install gitleaks" >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner --config .gitleaks.toml
