# Copy to .env (never commit .env) and fill in the values.
#
# Dev AND tests use PostgreSQL 18 installed natively on this machine (localhost:5432), no Docker
# (docs/adr/0011-local-postgres-for-dev-and-tests.md). One-time setup (see README):
#   1. install PostgreSQL 18, remember the `postgres` superuser password
#   2. fill in this file
#   3. pnpm db:local:setup   (creates roles anon/authenticated and the database lms_dev; refuses non-localhost)
#   4. pnpm db:migrate && pnpm db:seed

# --- dev database lms_dev: owner/migration connection (user "postgres") ----------------------
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/lms_dev

# --- dev database: application connection as role lms_app ------------------------------------
# The password here MUST equal LMS_APP_PASSWORD below.
DATABASE_APP_URL=postgresql://lms_app:<LMS_APP_PASSWORD>@localhost:5432/lms_dev

# --- lms_app password ---------------------------------------------------------
# Set by `pnpm db:migrate` via ALTER ROLE (the role is cluster-wide: one password serves the dev database
# and every test database). Use a long URL-safe random string (letters/digits only), e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LMS_APP_PASSWORD=<GENERATE_A_STRONG_ALPHANUMERIC_PASSWORD>

# --- test databases ---------------------------------------------------------------------------
# The BASE name (lms_test). Vitest creates and migrates one database per worker: lms_test_1 ... lms_test_N.
# Tests refuse to run when the name equals the dev database name (on any host).
TEST_DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/lms_test
TEST_DATABASE_APP_URL=postgresql://lms_app:<LMS_APP_PASSWORD>@localhost:5432/lms_test
# Parallel DB test workers (default: CPU cores - 1, max 16)
# TEST_DB_WORKERS=3
# REMOTE_DB=1 : profile for a slow remote database (one worker, one database, 120 s per test, no CREATE DATABASE)

# --- TLS to Postgres: off | no-verify | verify-full -----------------------------------
# off: no TLS. Allowed ONLY when every database URL is localhost / 127.0.0.1 and NODE_ENV is not production.
# no-verify: encrypts but does not verify the server. Allowed ONLY in development/test (warns at startup).
# verify-full: required in production; set DB_SSL_CA to the server CA file (Cloud SQL server CA), kept outside the repo.
DB_SSL=off
# DB_SSL_CA=C:\certs\server-ca.pem


# --- Optional tuning -----------------------------------------------------------------
# Pool size per process. Default: 5 in development/test, 10 in production.
# Keep it small locally: every test worker holds a few connections (PostgreSQL allows 100).
# DB_POOL_MAX=5
# PORT=3000
# LOG_LEVEL=info
# CORS_ORIGINS=http://localhost:5173

# --- Authentication (step 2) -------------------------------------------------------------
# Tenants are served at <slug>.<APP_BASE_DOMAIN>; the platform admin area is admin.<APP_BASE_DOMAIN>.
# Locally, *.localhost resolves to 127.0.0.1 (e.g. http://alpha-college.localhost:5173).
# Required (explicit) when NODE_ENV=production.
# APP_BASE_DOMAIN=localhost
# Dev-only password given to EVERY seeded user by `pnpm db:seed` (min 10 chars). The seed refuses to
# run when NODE_ENV=production. Make this long and random; it also lets you log in locally.
SEED_USER_PASSWORD=<DEV_ONLY_PASSWORD_AT_LEAST_10_CHARS>
# Session lifetime: idle timeout and absolute lifetime, in days (defaults 7 / 30)
# SESSION_IDLE_DAYS=7
# SESSION_ABSOLUTE_DAYS=30
# Cookie Secure flag + __Host- prefix. Default: on in production, off for local development.
# COOKIE_SECURE=false
# Account lockout: after N wrong passwords lock for LOCKOUT_BASE_SECONDS, doubling, capped at
# LOCKOUT_MAX_SECONDS (15 minutes). A password reset or an admin unlock clears the lock immediately.
# LOGIN_MAX_ATTEMPTS=10
# LOCKOUT_BASE_SECONDS=60
# LOCKOUT_MAX_SECONDS=900
# Stricter limits for login, password-reset request and invite accept (per minute; in-memory, per instance)
# RATE_LIMIT_LOGIN_PER_IP=10
# RATE_LIMIT_LOGIN_PER_EMAIL=5
# Concurrent argon2 hashes (they run on the libuv threadpool, which the start scripts size via UV_THREADPOOL_SIZE=8)
# PASSWORD_HASH_CONCURRENCY=2
# Tenant slug cache (short TTL; sessions are checked against tenant status in the database on every request)
# TENANT_CACHE_TTL_MS=60000
# TENANT_CACHE_MAX=1000
# Mail: "console" logs emails (links included) - development only, rejected in production; "none" drops them
# until a real provider is wired in.
# MAILER=console
# MAILER=file writes one JSON line per email to MAIL_FILE (dev / E2E only: links in clear text, refused in
# production). The E2E tests read invite and reset links from it. The .mail/ folder is git-ignored.
# MAILER=file
# MAIL_FILE=.mail/outbox.jsonl
# Cleanup of dead sessions and used/expired invite/reset tokens (run by the worker on this interval)
# PURGE_RETENTION_DAYS=30
# PURGE_INTERVAL_SECONDS=3600
# PURGE_BATCH_SIZE=1000


# Background job queue (Postgres table + FOR UPDATE SKIP LOCKED); the worker polls, the API only enqueues
# JOB_POLL_INTERVAL_MS=1000          fast poll interval (an empty queue backs off 1s -> 2s -> 5s -> max)
# JOB_POLL_MAX_INTERVAL_MS=10000     longest idle wait; a claimed job or an in-process enqueue resets it
# JOB_LEASE_SECONDS=60               running jobs renew their lease every third of this; a dead worker's jobs are re-claimed after it
# JOB_MAX_ATTEMPTS=5
# JOB_BACKOFF_BASE_SECONDS=10        retry delay = base * 2^(attempt-1), jittered, capped by JOB_BACKOFF_MAX_SECONDS
# JOB_BACKOFF_MAX_SECONDS=3600
# JOB_SHUTDOWN_GRACE_SECONDS=8       keep below SHUTDOWN_TIMEOUT_MS; unfinished jobs are released back to the queue
# JOB_CONCURRENCY=default:2          max jobs at once per queue, e.g. imports:1,invites:4,default:2
# JOBS_COMPLETED_RETENTION_DAYS=7
# JOBS_DEAD_RETENTION_DAYS=30

# Bulk CSV import (students and faculty)
# IMPORT_MAX_BYTES=5242880          upload size limit (checked while streaming)
# IMPORT_MAX_ROWS=10000             row limit
# IMPORT_BATCH_SIZE=500             rows applied per transaction by the worker
# IMPORT_RETENTION_DAYS=7           staged rows (names, emails) are deleted this long after an import ended
# INVITE_RATE_PER_SECOND=5          invite emails of an import are spread out to at most this many per second
# APP_PUBLIC_PORT=5173              development only: the port in the links of queued emails

# File storage (course files). The LOCAL driver keeps bytes on this machine and serves them through signed URLs
# of the API: development only, REFUSED when NODE_ENV=production. The GCS driver comes with the GCP step.
# STORAGE_DRIVER=local               local | gcs
# STORAGE_LOCAL_DIR=.storage         git-ignored
STORAGE_SIGNING_SECRET=change-me-to-32-or-more-random-characters
# STORAGE_MAX_FILE_BYTES=52428800    50 MB per file
# STORAGE_URL_TTL_SECONDS=300        lifetime of a signed upload / download URL
# STORAGE_GCS_BUCKET=                required for STORAGE_DRIVER=gcs
# FILE_PURGE_GRACE_HOURS=24          an unreferenced file is deleted this long after upload confirmation / its last use
# FILE_PURGE_INTERVAL_SECONDS=3600
